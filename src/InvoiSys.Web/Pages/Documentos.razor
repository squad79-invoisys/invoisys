    private async Task CopiarAsync(string texto, string mensagem)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", texto);
            Snackbar.Add(mensagem, Severity.Success);
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            Snackbar.Add("Não foi possível copiar automaticamente.", Severity.Warning);
        }
    }

