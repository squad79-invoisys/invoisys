    private static string FormatarOrigem(string origem) =>
        Uri.TryCreate(origem, UriKind.Absolute, out var uri) ? uri.Host : origem;

    // Só links http/https viram <a>: a URL vem de fontes externas e "javascript:" também é uma URI absoluta.
    private static bool UrlSegura(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    private static string AbreviarHash(string hash) =>
        hash.Length <= 14 ? hash : $"{hash[..8]}…{hash[^4..]}";

    private static string Resumir(string texto, int limite)
    {
        var limpo = texto.Trim();
        return limpo.Length <= limite ? limpo : limpo[..limite].TrimEnd() + "…";
    }

    private static List<(string Chave, string Valor)> LerMetadados(string? json)
    {
        var itens = new List<(string Chave, string Valor)>();

        if (string.IsNullOrWhiteSpace(json))
            return itens;

        try
        {
            using var documento = JsonDocument.Parse(json);

            if (documento.RootElement.ValueKind != JsonValueKind.Object)
            {
                itens.Add(("Valor", Resumir(json, 300)));
                return itens;
            }

            foreach (var propriedade in documento.RootElement.EnumerateObject())
            {
                // Os anexos têm seção própria; aqui seriam só JSON bruto.
                if (string.Equals(propriedade.Name, "anexos", StringComparison.OrdinalIgnoreCase))
                    continue;

                var valor = propriedade.Value.ValueKind switch
                {
                    JsonValueKind.String => propriedade.Value.GetString(),
                    JsonValueKind.Null or JsonValueKind.Undefined => (string?)null,
                    _ => propriedade.Value.GetRawText()
                };

                if (!string.IsNullOrWhiteSpace(valor))
                    itens.Add((RotuloMetadado(propriedade.Name), Resumir(valor, 300)));
            }
        }
        catch (JsonException)
        {
            itens.Add(("Valor", Resumir(json, 300)));
        }

        return itens;
    }

    private static string RotuloMetadado(string nome) => nome.ToLowerInvariant() switch
    {
        "descricao" => "Descrição",
        "idioma" => "Idioma",
        "canonica" => "URL canônica",
        "" => nome,
        _ => char.ToUpperInvariant(nome[0]) + nome[1..]
    };

    // Datas chegam da API em UTC; a tela mostra no fuso do navegador.
    private static string FormatarDataHora(DateTimeOffset valor)
    {
        var local = valor.ToLocalTime();
        var hoje = DateTime.Today;
        var hora = local.ToString("HH:mm");

        if (local.Date == hoje)
            return $"Hoje, {hora}";

        if (local.Date == hoje.AddDays(-1))
            return $"Ontem, {hora}";

        return local.ToString("dd/MM/yyyy, HH:mm");
    }

    private static string FormatarData(DateTimeOffset? valor) =>
        valor is { } data ? data.ToLocalTime().ToString("dd/MM/yyyy") : "—";

    private static string FormatarDataHoraCompleta(DateTimeOffset? valor) =>
        valor is { } data ? data.ToLocalTime().ToString("dd/MM/yyyy, HH:mm") : "—";

    // As respostas de erro da API seguem o formato ApiResponse { mensagem }.
    private static async Task<string> MensagemDeErroAsync(Refit.ApiException exception, string mensagemPadrao)
    {
        if (exception.StatusCode == HttpStatusCode.Unauthorized)
            return "Sua sessão expirou. Entre novamente.";

        if (exception.StatusCode == HttpStatusCode.Forbidden)
            return "Você não tem permissão para realizar esta ação.";

        try
        {
            var corpo = await exception.GetContentAsAsync<InvoiSys.Application.Common.Responses.ApiResponse<object>>();

            if (!string.IsNullOrWhiteSpace(corpo?.Mensagem))
                return corpo.Mensagem;
        }
        catch (Exception)
        {
            // Corpo ausente ou fora do formato esperado: usa a mensagem padrão.
        }

        return mensagemPadrao;
    }

