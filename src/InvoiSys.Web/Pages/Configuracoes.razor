@page "/configuracoes"
@attribute [Authorize]
@using System.Security.Claims

<PageTitle>Configurações - InvoiSys</PageTitle>

<section class="configuracoes-page" aria-label="Configurações">
    <header class="configuracoes-header">
        <MudText Typo="Typo.h3" Class="configuracoes-title">Configurações</MudText>
        <MudText Typo="Typo.body1">Consulte sua conta e gerencie os acessos à plataforma</MudText>
    </header>

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="configuracoes-tabs">
        <MudTabPanel Text="Minha conta" Icon="@Icons.Material.Outlined.AccountCircle">
            <div class="configuracoes-panel conta-card">
                <span class="conta-avatar" aria-hidden="true">@UserDisplay.Iniciais(_nome)</span>
                <dl class="conta-dados">
                    <div><dt>Nome</dt><dd>@_nome</dd></div>
                    <div><dt>E-mail</dt><dd>@_email</dd></div>
                    <div><dt>Perfil</dt><dd>@_perfis</dd></div>
                </dl>
            </div>
        </MudTabPanel>

        @if (_administrador)
        {
            <MudTabPanel Text="Usuários" Icon="@Icons.Material.Outlined.Group">
                <div class="configuracoes-panel">
                    <Usuarios />
                </div>
            </MudTabPanel>
        }
    </MudTabs>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string _nome = string.Empty;
    private string _email = string.Empty;
    private string _perfis = string.Empty;
    private bool _administrador;

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await AuthenticationState).User;

        _nome = UserDisplay.Identificacao(usuario);
        _email = usuario.FindFirst(ClaimTypes.Email)?.Value ?? "—";
        _perfis = string.Join(", ", usuario.FindAll(ClaimTypes.Role).Select(perfil => perfil.Value));
        _administrador = usuario.IsInRole("Administrador");
    }
}
