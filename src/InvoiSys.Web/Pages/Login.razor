@page "/login"
@layout LoginLayout
@using InvoiSys.Web.Contracts
@using System.Net
@using Refit
@inject AuthClient AuthClient
@inject NavigationManager NavigationManager

<PageTitle>Login - InvoiSys</PageTitle>

<div class="login-card">
    <div class="login-logo" aria-label="InvoiSys">
        <span class="login-logo-bar"></span>invoi<span class="login-logo-sys">Sys</span>
    </div>

    <h1 class="login-title">Acesso ao Sistema</h1>

    <form @onsubmit="EntrarAsync">
        <label class="login-label" for="login-email">Email</label>
        <input id="login-email"
               class="login-input"
               type="email"
               autocomplete="username"
               @bind="_model.Email" />

        <label class="login-label" for="login-senha">Senha</label>
        <input id="login-senha"
               class="login-input"
               type="password"
               autocomplete="current-password"
               @bind="_model.Senha" />

        @* Sem endpoint de recuperação de senha na API: link desabilitado nesta entrega. *@
        <div class="login-forgot">
            <span class="login-forgot-disabled"
                  aria-disabled="true"
                  title="Recuperação de senha ainda não disponível">Esqueceu a senha?</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_erro))
        {
            <MudAlert Severity="Severity.Error" Class="login-error">
                @_erro
            </MudAlert>
        }

        <button type="submit" class="login-submit" disabled="@_carregando">Entrar</button>

        @* Apenas visual: o comportamento (duração da sessão) ainda precisa ser definido. *@
        <label class="login-remember">
            <input type="checkbox" @bind="_lembrarDeMim" />
            Lembrar de mim
        </label>
    </form>

    <div class="login-tip">
        <p class="login-tip-title">Dica rápida</p>
        <p class="login-tip-text">
            Seu login dá acesso a todas as funcionalidades de gestão de fontes,
            coletas e documentos. <strong>Proteja suas credenciais.</strong>
        </p>
    </div>
</div>

@code {
    private readonly LoginFormModel _model = new();
    private string? _erro;
    private bool _carregando;
    private bool _lembrarDeMim;

    private async Task EntrarAsync()
    {
        _carregando = true;
        _erro = null;

        try
        {
            var sucesso = await AuthClient.LoginAsync(
                _model.Email,
                _model.Senha);

            if (!sucesso)
            {
                _erro = "Não foi possível entrar.";
                return;
            }

            NavigationManager.NavigateTo("/");
        }
        catch (ApiException exception)
            when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            _erro = "E-mail ou senha inválidos.";
        }
        catch (ApiException exception)
        {
            Console.Error.WriteLine(exception);
            Console.Error.WriteLine(exception.Content);
            _erro = "Não foi possível acessar a API. Tente novamente.";
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _erro = "Não foi possível acessar a API. Tente novamente.";
        }
        finally
        {
            _carregando = false;
        }
    }
}
