@page "/fontes"
@attribute [Authorize]
@implements IDisposable
@using System.Net
@using InvoiSys.Application.Coletas
@using InvoiSys.Application.Fontes
@using InvoiSys.Domain.Enums
@using InvoiSys.Web.Components.Fontes
@inject IFontesClient FontesClient
@inject IColetasClient ColetasClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Fontes - InvoiSys</PageTitle>

<section class="fontes-page" aria-label="Fontes">
    <header class="fontes-header">
        <MudText Typo="Typo.h4">Fontes</MudText>
        <MudText Typo="Typo.body1" Class="page-subtitle">Cadastre, edite e acompanhe as fontes monitoradas pela plataforma</MudText>
    </header>

    <div class="fontes-filter-bar">
        <MudTextField T="string" Placeholder="Buscar fonte..." Variant="Variant.Outlined"
                      Margin="Margin.Dense" aria-label="Buscar fonte" />
        <MudSelect T="string" Label="Tipo" Value="@("Todos")" Variant="Variant.Outlined" Margin="Margin.Dense"
                   aria-label="Filtrar por tipo">
            <MudSelectItem Value="@("Todos")">Todos</MudSelectItem>
        </MudSelect>
        <MudSelect T="string" Label="Status" Value="@("Todos")" Variant="Variant.Outlined" Margin="Margin.Dense"
                   aria-label="Filtrar por status">
            <MudSelectItem Value="@("Todos")">Todos</MudSelectItem>
        </MudSelect>
        <MudTextField T="string" @bind-Value="_contextoFiltro" @bind-Value:after="FiltrarPorContextoAsync"
                      Label="Contexto" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      DebounceInterval="350" Clearable="true" aria-label="Filtrar fontes por contexto" />
        <MudSelect T="string" Label="Periodicidade" Value="@("Todas")" Variant="Variant.Outlined" Margin="Margin.Dense"
                   aria-label="Filtrar por periodicidade">
            <MudSelectItem Value="@("Todas")">Todas</MudSelectItem>
        </MudSelect>
        <AuthorizeView Roles="Administrador,Operador" Context="newSourceAuthorization">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                           OnClick="AbrirCadastroAsync" Class="nova-fonte-button">Nova fonte</MudButton>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="fontes-summary" aria-label="Resumo das fontes">
        <SummaryCard Title="Total de fontes" Value="@_totalFontes" Icon="@Icons.Material.Outlined.Adjust"
                     Tone="success" Description="100% do total cadastrado" />
        <SummaryCard Title="Fontes ativas" Value="@_totalAtivas" Icon="@Icons.Material.Outlined.Check"
                     Tone="success" Description="@($"{FormatarPercentual(_totalAtivas)} do total cadastrado")" />
        <SummaryCard Title="Fontes inativas" Value="@_totalInativas" Icon="@Icons.Material.Outlined.Block"
                     Tone="warning" Description="@($"{FormatarPercentual(_totalInativas)} do total cadastrado")" />
    </div>

    <div class="fontes-data-grid">
    <div class="fontes-table-card">
        @if (_carregando)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        <MudTable @ref="_tabela" Items="_fontes" Hover="true" Loading="_carregando" Breakpoint="Breakpoint.Sm"
                  RowsPerPage="10" Elevation="0" Class="fontes-table">
            <HeaderContent>
                <MudTh>Fonte</MudTh><MudTh>Tipo</MudTh><MudTh>Contexto</MudTh><MudTh>URL</MudTh><MudTh>Status</MudTh>
                <MudTh>Periodicidade</MudTh><MudTh>Última coleta</MudTh><MudTh Class="actions-column">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Fonte">
                    <div class="fonte-name">
                        <span class="fonte-avatar" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Adjust" Size="Size.Small" /></span>
                        <span title="@context.Nome">@context.Nome</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="Tipo">@FormatarTipo(context.Tipo)</MudTd>
                <MudTd DataLabel="Contexto">@context.Contexto</MudTd>
                <MudTd DataLabel="URL">
                    <a class="fonte-url" href="@context.Url" target="_blank" rel="noopener noreferrer" title="@context.Url">@context.Url</a>
                </MudTd>
                <MudTd DataLabel="Status"><span class="status-badge @ObterClasseStatus(context.Status)">@FormatarStatus(context.Status)</span></MudTd>
                <MudTd DataLabel="Periodicidade">@FormatarPeriodicidade(context.PeriodicidadeMinutos)</MudTd>
                <MudTd DataLabel="Última coleta">—</MudTd>
                <MudTd DataLabel="Ações" Class="actions-column">
                    <div class="row-actions">
                        <MudTooltip Text="Visualizar detalhes">
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small"
                                           OnClick="@(() => SelecionarFonteAsync(context))" aria-label="Ver detalhes" />
                        </MudTooltip>
                        <AuthorizeView Roles="Administrador,Operador" Context="rowAuthorization">
                            <Authorized>
                                <MudTooltip Text="Editar fonte">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                                   Disabled="@(_fonteEmAlteracaoId is not null)"
                                                   OnClick="@(() => AbrirEdicaoAsync(context))" aria-label="Editar fonte" />
                                </MudTooltip>
                                <MudTooltip Text="@(context.Status == StatusFonte.Ativa ? "Inativar fonte" : "Ativar fonte")">
                                    <MudIconButton Icon="@(context.Status == StatusFonte.Ativa ? Icons.Material.Outlined.PauseCircleOutline : Icons.Material.Outlined.PlayCircleOutline)"
                                                   Size="Size.Small" Color="@(context.Status == StatusFonte.Ativa ? Color.Warning : Color.Success)"
                                                   Disabled="@(_fonteEmAlteracaoId is not null)"
                                                   OnClick="@(() => ConfirmarAlteracaoStatusAsync(context))"
                                                   aria-label="@(context.Status == StatusFonte.Ativa ? "Inativar fonte" : "Ativar fonte")" />
                                </MudTooltip>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Outlined.Source" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle1">Nenhuma fonte cadastrada</MudText>
                    <MudText Typo="Typo.body2">Cadastre a primeira fonte para começar.</MudText>
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" RowsPerPageString="por página"
                               InfoFormat="Exibindo {first_item}–{last_item} de {all_items} fontes" />
            </PagerContent>
        </MudTable>
    </div>

    <aside class="fonte-details-card" aria-label="Detalhes da fonte">
        <h2>Detalhes da fonte</h2>
        @if (_fonteSelecionada is { } fonte)
        {
            <div class="details-heading">
                <span class="details-avatar"><MudIcon Icon="@Icons.Material.Outlined.Adjust" /></span>
                <div class="details-name"><strong>@fonte.Nome</strong><span>@FormatarTipo(fonte.Tipo)</span></div>
                <span class="status-badge @ObterClasseStatus(fonte.Status)">@FormatarStatus(fonte.Status)</span>
            </div>
            <dl class="details-list">
                <div><dt>Tipo</dt><dd>@FormatarTipo(fonte.Tipo)</dd></div>
                <div><dt>Contexto</dt><dd title="@fonte.Contexto">@fonte.Contexto</dd></div>
                <div><dt>URL</dt><dd title="@fonte.Url">@fonte.Url</dd></div>
                <div><dt>Periodicidade</dt><dd>@FormatarPeriodicidade(fonte.PeriodicidadeMinutos)</dd></div>
                <div><dt>Timeout</dt><dd>—</dd></div>
                <div><dt>Última execução</dt><dd>@TextoUltimaExecucao(_resumo)</dd></div>
                <div><dt>Próxima execução</dt><dd>—</dd></div>
                <div><dt>Documentos coletados</dt><dd>@TextoDocumentos(_resumo)</dd></div>
                <div>
                    <dt>Taxa de sucesso (24h)</dt>
                    <dd class="@(_resumo?.TaxaSucesso24h is not null ? "details-success" : null)">@TextoTaxaSucesso(_resumo)</dd>
                </div>
            </dl>
            <AuthorizeView Roles="Administrador,Operador" Context="detailsAuthorization">
                <Authorized>
                    <div class="details-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Edit"
                                   Disabled="@(_fonteEmAlteracaoId is not null)" OnClick="@(() => AbrirEdicaoAsync(fonte))">Editar fonte</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlayArrow"
                                   Disabled="@(_executandoColeta || fonte.Status != StatusFonte.Ativa)"
                                   OnClick="@(() => ExecutarColetaAsync(fonte))">
                            @(_executandoColeta ? "Executando..." : "Executar coleta")
                        </MudButton>
                    </div>
                </Authorized>
            </AuthorizeView>
        }
        else
        {
            <div class="details-empty">Selecione uma fonte para visualizar os detalhes.</div>
        }
    </aside>
    </div>

    <div class="fontes-tip">
        <span class="tip-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.LightMode" /></span>
        <div class="tip-content">
            <strong>Dica rápida</strong>
            <p>Use os filtros para encontrar fontes rapidamente e acompanhe o status para evitar interrupções nas coletas.</p>
        </div>
    </div>
</section>

@code {
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private IReadOnlyList<FonteResponse> _fontes = [];
    private MudTable<FonteResponse>? _tabela;
    private bool _carregando = true;
    private int _totalFontes;
    private int _totalAtivas;
    private int _totalInativas;
    private FonteResponse? _fonteSelecionada;
    private Guid? _fonteEmAlteracaoId;
    private string? _contextoFiltro;

    // A API aceita no máximo 100 itens por página (ListarColetasValidator).
    private const int TamanhoMaximoPagina = 100;

    private sealed record ResumoExecucoes(
        Guid FonteId,
        DateTimeOffset? UltimaExecucao,
        int DocumentosColetados,
        bool Parcial,
        double? TaxaSucesso24h);

    private ResumoExecucoes? _resumo;
    private bool _executandoColeta;

    protected override async Task OnInitializedAsync() => await CarregarFontesAsync();

    private async Task FiltrarPorContextoAsync()
    {
        _tabela?.NavigateTo(Page.First);
        await CarregarFontesAsync();
    }

    private async Task CarregarFontesAsync()
    {
        _carregando = true;
        try
        {
            var response = await FontesClient.ListarAsync(tamanhoPagina: 50, contexto: _contextoFiltro, cancellationToken: _cancellationTokenSource.Token);
            if (!response.Sucesso)
            {
                Snackbar.Add(response.Mensagem, Severity.Error);
                return;
            }

            var fonteSelecionadaId = _fonteSelecionada?.Id;
            _fontes = response.Dados?.Itens ?? [];
            _fonteSelecionada = fonteSelecionadaId is null
                ? _fontes.FirstOrDefault()
                : _fontes.FirstOrDefault(fonte => fonte.Id == fonteSelecionadaId) ?? _fontes.FirstOrDefault();

            await CarregarContadoresAsync();
        }
        catch (OperationCanceledException) when (_cancellationTokenSource.IsCancellationRequested) { }
        catch (Refit.ApiException exception)
        {
            Console.Error.WriteLine(exception);
            Snackbar.Add("Não foi possível carregar as fontes. Tente novamente.", Severity.Error);
        }
        finally { _carregando = false; }

        await CarregarResumoAsync();
    }

    private async Task CarregarContadoresAsync()
    {
        var response = await FontesClient.ObterResumoAsync(_cancellationTokenSource.Token);
        if (!response.Sucesso || response.Dados is not { } dados)
        {
            Snackbar.Add(response.Mensagem, Severity.Error);
            return;
        }

        _totalFontes = dados.TotalFontes;
        _totalAtivas = dados.FontesAtivas;
        _totalInativas = dados.FontesInativas;
    }

    private async Task AbrirCadastroAsync()
    {
        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<NovaFonteDialog>("Nova fonte", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await CarregarFontesAsync();
            Snackbar.Add("Fonte criada com sucesso.", Severity.Success);
        }
    }

    private async Task AbrirEdicaoAsync(FonteResponse fonte)
    {
        var parameters = new DialogParameters
        {
            [nameof(NovaFonteDialog.Fonte)] = fonte
        };
        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<NovaFonteDialog>("Editar fonte", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await CarregarFontesAsync();
            Snackbar.Add("Fonte atualizada com sucesso.", Severity.Success);
        }
    }

    private async Task ConfirmarAlteracaoStatusAsync(FonteResponse fonte)
    {
        var ativar = fonte.Status == StatusFonte.Inativa;
        var acao = ativar ? "ativar" : "inativar";
        var confirmado = await DialogService.ShowMessageBoxAsync(
            $"{(ativar ? "Ativar" : "Inativar")} fonte",
            $"Deseja realmente {acao} a fonte “{fonte.Nome}”?",
            yesText: ativar ? "Ativar" : "Inativar",
            cancelText: "Cancelar");

        if (confirmado is not true)
            return;

        _fonteEmAlteracaoId = fonte.Id;
        try
        {
            var response = ativar
                ? await FontesClient.AtivarAsync(fonte.Id, _cancellationTokenSource.Token)
                : await FontesClient.DesativarAsync(fonte.Id, _cancellationTokenSource.Token);

            if (!response.Sucesso)
            {
                Snackbar.Add(response.Mensagem, Severity.Error);
                return;
            }

            await CarregarFontesAsync();
            Snackbar.Add(response.Mensagem, Severity.Success);
        }
        catch (OperationCanceledException) when (_cancellationTokenSource.IsCancellationRequested) { }
        catch (Refit.ApiException exception)
        {
            Console.Error.WriteLine(exception);
            Snackbar.Add("Não foi possível alterar o status da fonte. Tente novamente.", Severity.Error);
        }
        finally
        {
            _fonteEmAlteracaoId = null;
        }
    }

    private string FormatarPercentual(int quantidade) => _totalFontes == 0 ? "0%" : $"{quantidade * 100d / _totalFontes:0.#}%";

    private async Task SelecionarFonteAsync(FonteResponse fonte)
    {
        _fonteSelecionada = fonte;
        await CarregarResumoAsync();
    }

    // Não existe endpoint de resumo por fonte: os números saem das execuções mais recentes dela.
    private async Task CarregarResumoAsync()
    {
        if (_fonteSelecionada is not { } fonte)
        {
            _resumo = null;
            return;
        }

        var fonteId = fonte.Id;
        if (_resumo?.FonteId != fonteId)
            _resumo = null;

        try
        {
            var resposta = await ColetasClient.ListarAsync(
                1, TamanhoMaximoPagina, fonteId, cancellationToken: _cancellationTokenSource.Token);

            var dados = resposta.Dados;
            IReadOnlyList<ExecucaoColetaResponse> execucoes = dados?.Itens ?? [];

            // O usuário pode ter selecionado outra fonte enquanto esta carregava.
            if (_fonteSelecionada?.Id != fonteId)
                return;

            var desde = DateTimeOffset.UtcNow.AddHours(-24);
            var finalizadas24h = execucoes
                .Where(e => e.Inicio >= desde && e.Status != StatusExecucaoColeta.EmAndamento)
                .ToList();

            _resumo = new ResumoExecucoes(
                fonteId,
                execucoes.Count > 0 ? execucoes.Max(e => e.Inicio) : (DateTimeOffset?)null,
                execucoes.Where(e => e.Status == StatusExecucaoColeta.Concluida).Sum(e => e.QuantidadeDocumentos),
                (dados?.Total ?? 0) > execucoes.Count,
                finalizadas24h.Count == 0
                    ? null
                    : finalizadas24h.Count(e => e.Status == StatusExecucaoColeta.Concluida) * 100d / finalizadas24h.Count);
        }
        catch (OperationCanceledException) when (_cancellationTokenSource.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _resumo = null;
        }
    }

    private async Task ExecutarColetaAsync(FonteResponse fonte)
    {
        if (_executandoColeta)
            return;

        _executandoColeta = true;

        try
        {
            // A API executa a coleta de forma síncrona: a chamada só volta quando ela termina.
            var resposta = await ColetasClient.ExecutarAsync(fonte.Id, _cancellationTokenSource.Token);
            var execucao = resposta.Dados;

            Snackbar.Add(
                execucao is null
                    ? "Coleta executada com sucesso."
                    : $"Coleta concluída: {execucao.QuantidadeDocumentos} documento(s) coletado(s).",
                Severity.Success);
        }
        catch (OperationCanceledException) when (_cancellationTokenSource.IsCancellationRequested)
        {
            return;
        }
        catch (Refit.ApiException exception)
        {
            Snackbar.Add(
                await MensagemDeErroAsync(exception, "Não foi possível executar a coleta."),
                Severity.Error);
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            Snackbar.Add("Não foi possível acessar a API. Tente novamente.", Severity.Error);
        }
        finally
        {
            _executandoColeta = false;
        }

        // Uma coleta que falha também gera um registro, então atualiza em qualquer caso.
        await CarregarResumoAsync();
    }

    private static async Task<string> MensagemDeErroAsync(Refit.ApiException exception, string mensagemPadrao)
    {
        if (exception.StatusCode == HttpStatusCode.Unauthorized)
            return "Sua sessão expirou. Entre novamente.";

        if (exception.StatusCode == HttpStatusCode.Forbidden)
            return "Você não tem permissão para realizar esta ação.";

        try
        {
            var corpo = await exception.GetContentAsAsync<InvoiSys.Application.Common.Responses.ApiResponse<object>>();

            if (!string.IsNullOrWhiteSpace(corpo?.Mensagem))
                return corpo.Mensagem;
        }
        catch (Exception)
        {
            // Corpo ausente ou fora do formato esperado: usa a mensagem padrão.
        }

        return mensagemPadrao;
    }

    private static string TextoUltimaExecucao(ResumoExecucoes? resumo) =>
        resumo?.UltimaExecucao is { } inicio ? FormatarDataHora(inicio) : "—";

    private static string TextoDocumentos(ResumoExecucoes? resumo) =>
        resumo is null ? "—" : $"{resumo.DocumentosColetados:N0}{(resumo.Parcial ? "+" : "")}";

    private static string TextoTaxaSucesso(ResumoExecucoes? resumo) =>
        resumo?.TaxaSucesso24h is { } taxa ? $"{taxa:0.#}%" : "—";

    private static string FormatarDataHora(DateTimeOffset valor)
    {
        var local = valor.ToLocalTime();
        var hora = local.ToString("HH:mm");

        if (local.Date == DateTime.Today)
            return $"Hoje, {hora}";

        if (local.Date == DateTime.Today.AddDays(-1))
            return $"Ontem, {hora}";

        return local.ToString("dd/MM/yyyy, HH:mm");
    }

    private static string FormatarTipo(TipoFonte tipo) => tipo switch
    {
        TipoFonte.Rss => "RSS", TipoFonte.Atom => "Atom", TipoFonte.WebHtml => "Web HTML", _ => tipo.ToString()
    };
    private static string FormatarStatus(StatusFonte status) => status == StatusFonte.Ativa ? "Ativa" : "Inativa";
    private static string ObterClasseStatus(StatusFonte status) => status == StatusFonte.Ativa ? "status-active" : "status-inactive";
    private static string FormatarPeriodicidade(int minutos) => minutos switch
    {
        < 60 => $"{minutos} min", 60 => "1 hora", < 1_440 when minutos % 60 == 0 => $"{minutos / 60} horas",
        1_440 => "Diária", _ => $"{minutos} min"
    };

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}
