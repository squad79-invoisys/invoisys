@using System.Text.Json
@using InvoiSys.Application.Common.Responses
@using InvoiSys.Application.Fontes
@using InvoiSys.Application.Fontes.AtualizarFonte
@using InvoiSys.Application.Fontes.CriarFonte
@using InvoiSys.Domain.Enums
@using InvoiSys.Web.Contracts
@inject IFontesClient FontesClient

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <div class="form-fields">
                <MudTextField @bind-Value="_model.Nome" Label="Nome" Variant="Variant.Outlined" Required="true"
                              RequiredError="Informe o nome da fonte." MaxLength="150" Immediate="true"
                              Disabled="_salvando" aria-label="Nome da fonte" />
                <MudTextField @bind-Value="_model.Url" Label="URL" Variant="Variant.Outlined" InputType="InputType.Url"
                              Required="true" RequiredError="Informe a URL da fonte." MaxLength="2048" Immediate="true"
                              Validation="@(new Func<string, string?>(ValidarUrl))" Disabled="_salvando"
                              HelperText="Use uma URL completa iniciada por http:// ou https://" aria-label="URL da fonte" />
                <MudSelect T="TipoFonte?" @bind-Value="_model.Tipo" Label="Tipo" Variant="Variant.Outlined"
                           Required="true" RequiredError="Selecione o tipo da fonte." Disabled="_salvando" aria-label="Tipo da fonte">
                    @foreach (var tipo in Enum.GetValues<TipoFonte>())
                    {
                        <MudSelectItem T="TipoFonte?" Value="@((TipoFonte?)tipo)">@FormatarTipo(tipo)</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int?" @bind-Value="_model.PeriodicidadeMinutos" Label="Periodicidade (minutos)"
                                 Variant="Variant.Outlined" Required="true" RequiredError="Informe a periodicidade."
                                 Min="1" Max="43200" Validation="@(new Func<int?, string?>(ValidarPeriodicidade))" Disabled="_salvando"
                                 HelperText="Entre 1 minuto e 30 dias" aria-label="Periodicidade em minutos" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_erro))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_erro</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancelar" Disabled="_salvando">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarAsync" Disabled="_salvando"
                   StartIcon="@(_salvando ? null : Icons.Material.Outlined.Add)">
            @if (_salvando)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" /><span>Salvando...</span>
            }
            else { <span>@(_editando ? "Salvar alterações" : "Cadastrar fonte")</span> }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private readonly NovaFonteFormModel _model = new();
    private MudForm? _form;
    private string? _erro;
    private bool _salvando;
    private bool _modeloInicializado;

    [Parameter] public FonteResponse? Fonte { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private bool _editando => Fonte is not null;

    protected override void OnParametersSet()
    {
        if (_modeloInicializado || Fonte is null)
            return;

        _model.Nome = Fonte.Nome;
        _model.Url = Fonte.Url;
        _model.Tipo = Fonte.Tipo;
        _model.PeriodicidadeMinutos = Fonte.PeriodicidadeMinutos;
        _modeloInicializado = true;
    }

    private async Task SalvarAsync()
    {
        if (_form is null) return;
        await _form.ValidateAsync();
        if (!_form.IsValid || _model.Tipo is null || _model.PeriodicidadeMinutos is null) return;

        _salvando = true;
        _erro = null;
        try
        {
            var response = _editando
                ? await AtualizarAsync()
                : await CriarAsync();

            if (!response.Sucesso)
            {
                _erro = response.Mensagem;
                return;
            }

            MudDialog.Close(DialogResult.Ok(response.Dados));
        }
        catch (Refit.ApiException exception)
        {
            Console.Error.WriteLine(exception);
            _erro = ExtrairMensagem(exception) ?? "Não foi possível cadastrar a fonte. Verifique os dados e tente novamente.";
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _erro = "Não foi possível cadastrar a fonte. Tente novamente.";
        }
        finally { _salvando = false; }
    }

    private Task<ApiResponse<FonteResponse>> CriarAsync()
    {
        var request = new CriarFonteRequest(
            _model.Nome.Trim(),
            _model.Url.Trim(),
            _model.Tipo!.Value,
            _model.PeriodicidadeMinutos!.Value);

        return FontesClient.CriarAsync(request);
    }

    private Task<ApiResponse<FonteResponse>> AtualizarAsync()
    {
        var request = new AtualizarFonteRequest(
            _model.Nome.Trim(),
            _model.Url.Trim(),
            _model.Tipo!.Value,
            _model.PeriodicidadeMinutos!.Value);

        return FontesClient.AtualizarAsync(Fonte!.Id, request);
    }

    private static string? ExtrairMensagem(Refit.ApiException exception)
    {
        if (string.IsNullOrWhiteSpace(exception.Content)) return null;
        try
        {
            return JsonSerializer.Deserialize<InvoiSys.Application.Common.Responses.ApiResponse<JsonElement>>(
                exception.Content,
                JsonOptions)?.Mensagem;
        }
        catch (JsonException) { return null; }
    }

    private static string? ValidarUrl(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        return Uri.TryCreate(value.Trim(), UriKind.Absolute, out var uri) &&
               (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? null : "Informe uma URL HTTP ou HTTPS válida.";
    }

    private static string? ValidarPeriodicidade(int? value) => value switch
    {
        null => null, <= 0 => "A periodicidade deve ser maior que zero.",
        > 43_200 => "A periodicidade deve ser de no máximo 30 dias.", _ => null
    };

    private static string FormatarTipo(TipoFonte tipo) => tipo switch
    {
        TipoFonte.Rss => "RSS", TipoFonte.Atom => "Atom", TipoFonte.WebHtml => "Web HTML", _ => tipo.ToString()
    };

    private void Cancelar() => MudDialog.Cancel();
}
