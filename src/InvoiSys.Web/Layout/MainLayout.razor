@inherits LayoutComponentBase

<MudThemeProvider Theme="@InvoiSys.Web.Theme.AppTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudText Typo="Typo.h6">InvoiSys</MudText>
    </MudAppBar>

    <MudDrawer Open="true"
               Variant="DrawerVariant.Mini"
               Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                      Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
