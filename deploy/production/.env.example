# Dominio que aponta para o IP do VPS. O Caddy emite o certificado sozinho.
APP_DOMAIN=invoisys.com.br
# E-mail usado pelo Let's Encrypt para avisos de expiracao.
ACME_EMAIL=voce@exemplo.com

# Banco. A senha nao sai do servidor: o Postgres nao expoe porta para fora.
POSTGRES_DB=invoisys
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Chave de assinatura do JWT. Minimo 64 caracteres.
# Gere com: openssl rand -base64 64 | tr -d '\n'
JWT_KEY=

# Primeiro administrador, criado no primeiro start.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Tag das imagens no GHCR. "latest" acompanha a main; use "sha-xxxxxxx" ou
# uma versão (ex.: 1.2.0) para fixar ou voltar para uma versão anterior.
IMAGE_TAG=latest

# Deixe false se quiser subir sem o worker de coleta agendada rodando.
COLETA_AUTOMATICA=true
